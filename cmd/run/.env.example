# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id  # Required. The GCP Project ID (used for Firestore client and trace logger).
FIRESTORE_COLLECTION=vanity_urls           # Optional. The Firestore collection to read vanity URL mappings from (defaults to "vanity_urls").

# Application Configuration
PORT=8080                                 # Optional. The port for the main HTTP vanity url server (defaults to "8080").
HEALTH_PORT=8081                          # Optional. The port for the internal health check server (defaults to "8081").
VANITY_HOST=go.example.com                # Required. The domain name serving the vanity URLs.
CACHE_MAX_AGE=300                         # Optional. Cache Control max-age in seconds for public redirect responses (defaults to 300).

# OAuth 2.0 / OIDC Authentication Configuration
OAUTH_CLIENT_ID=your-oauth-client-id      # Required. The OAuth 2.0 Client ID for OIDC user login.
OAUTH_CLIENT_SECRET=your-client-secret    # Required. The OAuth 2.0 Client Secret.
OAUTH_REDIRECT_URL=https://go.example.com/_admin/callback  # Required. The OAuth 2.0 redirect/callback URL.

# Access Control Lists
ALLOWED_EMAILS=user1@example.com,user2@example.com  # Optional. Comma-separated list of allowed user email addresses.
ALLOWED_DOMAINS=example.com                         # Optional. Comma-separated list of allowed email domains.
